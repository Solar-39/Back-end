CREATE TABLE Cliente 
( 
 id INT PRIMARY KEY AUTO_INCREMENT,  
 nome VARCHAR(100) NOT NULL,  
 cpf CHAR (14) NOT NULL UNIQUE,  
 email VARCHAR(100) NOT NULL UNIQUE,  
 celular CHAR (14) NOT NULL,  
 senha VARCHAR (512) NOT NULL
);

